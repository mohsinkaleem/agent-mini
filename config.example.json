{
  "provider": "ollama",
  "providers": {
    "ollama": {
      "baseUrl": "http://localhost:11434",
      "model": "qwen3:8b",
      "think": false,
      "numCtx": null,
      "keepAlive": null
    },
    "openai": {
      "apiKey": "",
      "model": "gpt-5-mini"
    },
    "local": {
      "baseUrl": "http://localhost:8080/v1",
      "apiKey": "no-key",
      "model": "local-model"
    }
  },
  "agent": {
    "maxIterations": null,
    "temperature": 0.7,
    "systemPrompt": "",
    "showThinking": false
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "token": "",
      "allowFrom": [],
      "allowShell": false,
      "sharedMemory": false,
      "streamResponses": true
    }
  },
  "tools": {
    "sandboxLevel": "workspace",
    "confirm": ["shell_exec", "write_file", "code_edit"],
    "shellTimeout": 120,
    "shellEnvAllow": [],
    "blockedCommands": []
  },
  "memory": {
    "enabled": true,
    "maxEntries": 1000
  },
  "workspace": "~/.agent-mini/workspace"
}
